# Copy this file to .env for local development only.
# Never commit real secrets.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password

BTS_GAME_SECRET=game_secret

# Enable only for first admin bootstrap run, then set to false.
BTS_ADMIN_BOOTSTRAP_USERNAME=admin
BTS_ADMIN_BOOTSTRAP_PASSWORD=admin
BTS_ADMIN_BOOTSTRAP_ENABLED=false

